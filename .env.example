# Email notification for a picked date (Resend — https://resend.com)
#
# 1. Create a free Resend account with the address you want the mail to reach.
# 2. Copy an API key from https://resend.com/api-keys
# 3. Copy this file to .env.local and fill both values in.
#
# Without a verified domain, Resend delivers only to the address that owns the
# account — which is exactly this use case. To mail a different address, verify
# a domain and set NOTIFY_FROM to something on it.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_EMAIL=you@example.com

# Optional; defaults to Resend's shared sender.
# NOTIFY_FROM=Save the Date <hello@yourdomain.com>
